# Raw source data are immutable, large, and must never be committed.
data/raw/

# Generated/processed datasets remain local by default.
data/interim/
data/processed/
data/external/
data/cache/
data/downloads/
*.parquet
*.feather
*.arrow
*.h5
*.hdf5
*.zarr/
*.npz
*.npy

# Large tabular exports under data are local. Small report/thesis CSVs elsewhere
# remain trackable.
data/**/*.csv
data/**/*.tsv
data/**/*.jsonl

# Trained models, checkpoints, experiment stores, and optimizer state.
models/
artifacts/models/
checkpoints/
runs/
wandb/
mlruns/
*.pkl
*.pickle
*.joblib
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.xgb
*.lgb
*.model

# Raw atomistic/simulation formats outside data/raw are local by default.
*.extxyz
*.xyz
*.dump
*.lammpstrj
*.cfg
*.traj
*.vasp
POSCAR*
CONTCAR*
OUTCAR*
WAVECAR*
CHGCAR*

# Archives and disk images.
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.bz2
*.xz
*.iso

# Python virtual environments and package/build outputs.
.venv/
venv/
env/
ENV/
.python-version
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, type-checker, notebook, and coverage caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.ipynb_checkpoints/

# IDE/editor and operating-system metadata.
.vscode/
.idea/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini

# Local secrets and machine-specific configuration.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# Logs generated by programs; the curated Markdown audit log remains tracked.
logs/*.log
logs/*.out
logs/*.err

# Temporary and scratch outputs.
tmp/
temp/
scratch/
.cache/
cache/
*.tmp
*.temp
*.bak

# Phase 7 DFT executables write large local scratch/runtime data.  Only compact
# structures, input templates, parsed tables, figures and reports are tracked.
dft_runs/
dft_pseudopotentials/
*.UPF
*.upf
*.wfc*
*.mix*
*.save/

# Local spreadsheet lock files.
~$*.xlsx
~$*.xls
